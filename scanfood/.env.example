# ---------------------------------------------------------------------
# ScanFood — variables d'environnement
# ---------------------------------------------------------------------

# Signature des cookies de session. Obligatoire en production.
# Génère-la avec : openssl rand -base64 32
SESSION_SECRET=

# Base de données Postgres (Neon, Supabase, Vercel Postgres…).
# Laisse vide en développement : ScanFood bascule sur un magasin JSON local.
DATABASE_URL=

# Higgsfield — génération des vidéos de victoire / couronnement et des
# photos éditoriales. Sans clé, l'application sert les assets pré-générés.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# HIGGSFIELD_API_BASE=https://platform.higgsfield.ai
# HIGGSFIELD_VIDEO_MODEL=seedance_2_5
# HIGGSFIELD_IMAGE_MODEL=soul_2

# Cache Redis Upstash pour les générations Higgsfield.
# Laisse vide : le cache bascule sur un fichier local.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Mode démo : sert un jeu de produits local au lieu d'OpenFoodFacts.
# Utile pour développer sans réseau. Ne pas activer en production.
SCANFOOD_DEMO_DATA=0
